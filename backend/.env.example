# ── Supabase Configuration (Shared Development Database) ──────────
# Database sudah tersedia — TIDAK perlu membuat project Supabase sendiri.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Server Configuration ──────────────────────────────────────────
PORT=5003

# ── Blockchain (Sepolia Testnet / Hardhat) ────────────────────────
# Private key wallet merchant (untuk mengirim ETH saat withdrawal)
MERCHANT_PRIVATE_KEY="PRIVATEKEY METAMASK KAMU"
# Ethereum RPC URL (dari Alchemy/Infura) — WAJIB untuk auto-withdrawal
ETH_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY"
# Alamat wallet merchant (untuk menerima pembayaran)
MERCHANT_ETH_ADDRESS="0xYOUR_WALLET_ADDRESS"

# ── Midtrans Payment Gateway (QRIS) ─────────────────────────────
# Daftar gratis di https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# ── Resend Email (Invoice Otomatis) ──────────────────────────────
# Daftar gratis di https://resend.com (3000 email/bulan)
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="KaryaNusa <onboarding@resend.dev>"

# ── Frontend URL (untuk callback Midtrans) ───────────────────────
FRONTEND_URL="https://warnusthree.my.id"

